# ===========================================
# BEARD STYLE APP - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control!
# ===========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For Docker: use postgres as host
# For local: use localhost:5433
POSTGRES_USER=bearduser
POSTGRES_PASSWORD=beardpass123
POSTGRES_DB=beard_style_db

# JWT Configuration
# IMPORTANT: Generate a strong secret before first use!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend public URL (used to build image URLs returned to frontend)
BACKEND_URL=http://localhost:5000

# ===========================================
# AI API Keys - GET YOUR OWN KEYS
# ===========================================

# Claude AI (Anthropic) - for face analysis
# Get your key at: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your_claude_api_key_here

# Replicate - for realistic beard inpainting (Flux Dev)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# OpenAI DALL-E - for image generation (deprecated, optional)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Claude model ID - override to use a specific version
# Leave blank to use the default fallback in claudeService.js
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Set to 'true' to use mock AI responses (for development without API keys)
USE_MOCK_AI=true
