# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://bearduser:beardpass123@postgres:5432/beard_style_db
# For local development without Docker use:
# DATABASE_URL=postgresql://bearduser:beardpass123@localhost:5433/beard_style_db

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend public URL (used to build image URLs returned to frontend)
BACKEND_URL=http://localhost:5000

# Claude AI (Anthropic) - for face analysis
# Get your key at: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your_claude_api_key_here

# Replicate - for realistic beard inpainting (Flux Dev)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# OpenAI DALL-E (deprecated, optional)
OPENAI_API_KEY=your_openai_api_key_here

# Set to 'true' to skip all AI calls and use mock data
USE_MOCK_AI=false
