# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://bearduser:beardpass123@postgres:5432/beard_style_db

# For local development without Docker use:
# DATABASE_URL=postgresql://bearduser:beardpass123@localhost:5433/beard_style_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Claude AI Configuration
CLAUDE_API_KEY=your_claude_api_key_here
# Get your API key from: https://console.anthropic.com/settings/keys

# Replicate API — for realistic beard inpainting (Korak 3)
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Backend public URL (used to build image URLs returned to frontend)
BACKEND_URL=http://localhost:5000

# Set to 'true' to skip all AI calls and use mock data (for local dev without API keys)
USE_MOCK_AI=false
